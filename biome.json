{
	"$schema": "https://biomejs.dev/schemas/2.3.10/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*.ts",
			"**/test-helpers/**/*.ts",
			"packages/kubernetes/**/*.ts",
			"scripts/**/*.ts",
			"!packages/kubernetes/crds"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineEnding": "lf",
		"lineWidth": 120,
		"attributePosition": "auto",
		"useEditorconfig": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useBlockStatements": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"],
						"requireAscii": true
					}
				},
				"useNamingConvention": {
					"level": "error",
					"options": {
						"strictCase": false,
						"requireAscii": true,
						"conventions": [
							{
								"selector": {
									"kind": "enumMember"
								},
								"formats": ["CONSTANT_CASE"]
							},
							{
								"selector": {
									"kind": "objectLiteralProperty"
								},
								"match": "\\$?(.+)",
								"formats": ["camelCase", "CONSTANT_CASE"]
							}
						]
					}
				},
				"noNonNullAssertion": "error",
				"useImportType": "error",
				"useExportType": "error",
				"useNodejsImportProtocol": "error"
			},
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"quoteProperties": "asNeeded",
			"trailingCommas": "none",
			"semicolons": "asNeeded",
			"bracketSpacing": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/rabbitmq/src/management/**", "packages/rabbitmq/test-helpers/management-api.ts"],
			"linter": {
				"rules": {
					"style": {
						"useNamingConvention": {
							"level": "error",
							"options": {
								"strictCase": false,
								"requireAscii": true,
								"conventions": [
									{
										"selector": {
											"kind": "typeProperty"
										},
										"formats": ["camelCase", "snake_case"]
									},
									{
										"selector": {
											"kind": "objectLiteralProperty"
										},
										"match": "\\$?(.+)",
										"formats": ["camelCase", "snake_case", "PascalCase"]
									},
									{
										"selector": {
											"kind": "enumMember"
										},
										"formats": ["CONSTANT_CASE"]
									},
									{
										"selector": {
											"kind": "objectLiteralProperty"
										},
										"match": "\\$?(.+)",
										"formats": ["camelCase", "CONSTANT_CASE"]
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/json-schema/src/builder/index.ts"],
			"linter": {
				"rules": {
					"style": {
						"useNamingConvention": {
							"level": "error",
							"options": {
								"strictCase": false,
								"requireAscii": true,
								"conventions": [
									{
										"selector": {
											"kind": "objectLiteralProperty"
										},
										"match": "\\$?(.+)",
										"formats": ["camelCase", "PascalCase", "CONSTANT_CASE"]
									},
									{
										"selector": {
											"kind": "enumMember"
										},
										"formats": ["CONSTANT_CASE"]
									},
									{
										"selector": {
											"kind": "objectLiteralProperty"
										},
										"match": "\\$?(.+)",
										"formats": ["camelCase", "CONSTANT_CASE"]
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/fastify-plugins/src/helpers/endpoint.ts"],
			"linter": {
				"rules": {
					"style": {
						"useNamingConvention": {
							"level": "error",
							"options": {
								"strictCase": false,
								"requireAscii": true,
								"conventions": [
									{
										"selector": {
											"kind": "typeProperty"
										},
										"formats": ["camelCase", "PascalCase"]
									},
									{
										"selector": {
											"kind": "enumMember"
										},
										"formats": ["CONSTANT_CASE"]
									},
									{
										"selector": {
											"kind": "objectLiteralProperty"
										},
										"match": "\\$?(.+)",
										"formats": ["camelCase", "CONSTANT_CASE"]
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@domain/*", "@application/*"],
										"message": "A package MUST NOT depend on a domain or an application. See docs/conventions/workspace-structure.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["domains/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@domain/*", "@application/*"],
										"message": "A domain MUST NOT depend on another domain or on an application. See docs/conventions/workspace-structure.md."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["applications/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@application/*"],
										"message": "An application MUST NOT import from another application: extract the shared part into a package or a domain. See docs/conventions/workspace-structure.md."
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"plugins": ["./biome-plugins/no-exported-function-declaration.grit"]
}
