{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"allow": [
			"Bash(gh pr merge:*)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-conventions.ts\""
					}
				]
			}
		]
	}
}
