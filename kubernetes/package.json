	},
	"devDependencies": {
		"cdk8s": "^2.70.33",
		"cdk8s-cli": "^2.200.150",
		"cdk8s-plus-33": "^2.4.10",
		"constructs": "^10.4.4",
		"es-toolkit": "^1.43.0"
	}
}
